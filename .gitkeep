1	:root {
     2	  --bg: #f9faf8;
     3	  --surface: rgba(255, 255, 255, 0.75);
     4	  --text: #172124;
     5	  --muted-text: #4f6166;
     6	  --line: #dde5e8;
     7	  --primary: #0f7b70;
     8	  --primary-dark: #0d655d;
     9	  --glow: rgba(104, 221, 214, 0.18);
    10	}
    11	
    12	* {
    13	  box-sizing: border-box;
    14	}
    15	
    16	html {
    17	  scroll-behavior: smooth;
    18	}
    19	
    20	body {
    21	  margin: 0;
    22	  font-family: "Manrope", system-ui, sans-serif;
    23	  color: var(--text);
    24	  background: var(--bg);
    25	  line-height: 1.6;
    26	  overflow-x: hidden;
    27	}
    28	
    29	.bg-atmosphere {
    30	  position: fixed;
    31	  inset: 0;
    32	  pointer-events: none;
    33	  z-index: -1;
    34	}
    35	
    36	.mist {
    37	  position: absolute;
    38	  border-radius: 999px;
    39	  filter: blur(55px);
    40	  opacity: 0.5;
    41	  animation: drift 18s ease-in-out infinite alternate;
    42	}
    43	
    44	.mist-1 {
    45	  width: 33vw;
    46	  height: 33vw;
    47	  background: #e0f8f0;
    48	  top: -8vw;
    49	  left: -7vw;
    50	}
    51	
    52	.mist-2 {
    53	  width: 30vw;
    54	  height: 30vw;
    55	  background: #e4f0ff;
    56	  right: -5vw;
    57	  top: 12vh;
    58	  animation-delay: 4s;
    59	}
    60	
    61	.mist-3 {
    62	  width: 36vw;
    63	  height: 36vw;
    64	  background: #f0fff4;
    65	  left: 28vw;
    66	  bottom: -12vw;
    67	  animation-delay: 7s;
    68	}
    69	
    70	.grain {
    71	  position: absolute;
    72	  inset: 0;
    73	  background-image: radial-gradient(rgba(16, 20, 31, 0.04) 0.4px, transparent 0.4px);
    74	  background-size: 4px 4px;
    75	  opacity: 0.22;
    76	}
    77	
    78	.container {
    79	  width: min(1120px, 92%);
    80	  margin: 0 auto;
    81	}
    82	
    83	.section {
    84	  padding: 5rem 0;
    85	}
    86	
    87	.section-soft {
    88	  background: linear-gradient(180deg, rgba(255, 255, 255, 0.4), rgba(236, 246, 246, 0.45));
    89	}
    90	
    91	.header {
    92	  position: sticky;
    93	  top: 0;
    94	  z-index: 20;
    95	  backdrop-filter: blur(12px);
    96	  background: rgba(249, 250, 248, 0.8);
    97	  border-bottom: 1px solid rgba(221, 229, 232, 0.8);
    98	}
    99	
   100	.nav-wrap {
   101	  min-height: 74px;
   102	  display: flex;
   103	  align-items: center;
   104	  justify-content: space-between;
   105	  gap: 1rem;
   106	}
   107	
   108	.logo {
   109	  font-size: 1.3rem;
   110	  font-weight: 800;
   111	  text-decoration: none;
   112	  color: var(--text);
   113	  letter-spacing: 0.02em;
   114	}
   115	
   116	.logo span {
   117	  color: var(--primary);
   118	}
   119	
   120	.nav {
   121	  display: flex;
   122	  align-items: center;
   123	  gap: 1.1rem;
   124	}
   125	
   126	.nav a {
   127	  color: var(--text);
   128	  text-decoration: none;
   129	  font-weight: 600;
   130	  font-size: 0.95rem;
   131	}
   132	
   133	.menu-toggle {
   134	  display: none;
   135	  border: 1px solid var(--line);
   136	  background: white;
   137	  border-radius: 8px;
   138	  padding: 0.3rem 0.55rem;
   139	}
   140	
   141	.hero {
   142	  padding-top: 6.2rem;
   143	}
   144	
   145	.hero-grid,
   146	.process-grid {
   147	  display: grid;
   148	  grid-template-columns: 1.15fr 1fr;
   149	  gap: 2rem;
   150	  align-items: center;
   151	}
   152	
   153	.tag {
   154	  display: inline-flex;
   155	  margin: 0;
   156	  padding: 0.24rem 0.6rem;
   157	  border: 1px solid var(--line);
   158	  border-radius: 999px;
   159	  font-size: 0.83rem;
   160	  color: var(--primary-dark);
   161	  background: rgba(255, 255, 255, 0.72);
   162	}
   163	
   164	h1,
   165	h2,
   166	h3 {
   167	  line-height: 1.15;
   168	}
   169	
   170	h1 {
   171	  font-size: clamp(2rem, 5vw, 3.4rem);
   172	  margin: 1rem 0 0.8rem;
   173	  max-width: 14ch;
   174	}
   175	
   176	h2 {
   177	  margin: 1rem 0;
   178	  font-size: clamp(1.5rem, 3vw, 2.1rem);
   179	}
   180	
   181	.subtitle {
   182	  margin-top: 0;
   183	  color: var(--muted-text);
   184	  max-width: 55ch;
   185	}
   186	
   187	.hero-cta,
   188	.contact-cta {
   189	  display: flex;
   190	  gap: 0.8rem;
   191	  flex-wrap: wrap;
   192	}
   193	
   194	.glass-card {
   195	  background: var(--surface);
   196	  border: 1px solid rgba(255, 255, 255, 0.7);
   197	  border-radius: 16px;
   198	  padding: 1.4rem;
   199	  box-shadow: 0 18px 30px -22px rgba(7, 46, 43, 0.35), 0 0 24px -12px var(--glow);
   200	}
   201	
   202	.glass-card ul {
   203	  margin: 0;
   204	  padding-left: 1rem;
   205	  color: var(--muted-text);
   206	}
   207	
   208	.btn {
   209	  border: 1px solid transparent;
   210	  display: inline-flex;
   211	  align-items: center;
   212	  justify-content: center;
   213	  text-decoration: none;
   214	  border-radius: 11px;
   215	  padding: 0.78rem 1.15rem;
   216	  font-weight: 700;
   217	  transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
   218	}
   219	
   220	.btn:hover {
   221	  transform: translateY(-1px);
   222	}
   223	
   224	.btn-whatsapp {
   225	  background: var(--primary);
   226	  color: #fff !important;
   227	  box-shadow: 0 12px 18px -12px rgba(15, 123, 112, 0.65);
   228	}
   229	
   230	.btn-whatsapp:hover {
   231	  background: var(--primary-dark);
   232	}
   233	
   234	.btn-ghost {
   235	  color: var(--text);
   236	  border-color: var(--line);
   237	  background: rgba(255, 255, 255, 0.56);
   238	}
   239	
   240	.btn-small {
   241	  padding: 0.54rem 0.8rem;
   242	  font-size: 0.86rem;
   243	}
   244	
   245	.section-head {
   246	  margin-bottom: 1rem;
   247	}
   248	
   249	.product-grid {
   250	  display: grid;
   251	  grid-template-columns: repeat(2, minmax(0, 1fr));
   252	  gap: 1rem;
   253	}
   254	
   255	.product-card {
   256	  background: rgba(255, 255, 255, 0.8);
   257	  border: 1px solid var(--line);
   258	  border-radius: 16px;
   259	  padding: 1rem;
   260	  box-shadow: 0 8px 20px -20px rgba(22, 39, 56, 0.55);
   261	}
   262	
   263	.icon {
   264	  font-size: 1.35rem;
   265	}
   266	
   267	.product-card p,
   268	.steps,
   269	.why-list,
   270	.contact p {
   271	  color: var(--muted-text);
   272	}
   273	
   274	.inline-link {
   275	  font-weight: 700;
   276	  color: var(--primary-dark);
   277	  text-decoration: none;
   278	}
   279	
   280	.steps {
   281	  margin: 0;
   282	  padding-left: 1.1rem;
   283	  display: grid;
   284	  gap: 0.65rem;
   285	}
   286	
   287	.diagram {
   288	  background: rgba(255, 255, 255, 0.75);
   289	  border: 1px solid var(--line);
   290	  border-radius: 16px;
   291	  padding: 1rem;
   292	}
   293	
   294	.diagram svg {
   295	  width: 100%;
   296	  height: auto;
   297	}
   298	
   299	.svg-glass {
   300	  fill: rgba(243, 255, 255, 0.65);
   301	  stroke: #b4cbce;
   302	  stroke-width: 2;
   303	}
   304	
   305	.coil {
   306	  fill: none;
   307	  stroke: url(#tube);
   308	  stroke-width: 12;
   309	  stroke-linecap: round;
   310	  stroke-linejoin: round;
   311	}
   312	
   313	.drop {
   314	  fill: #74d3d5;
   315	  animation: pulse 2.8s ease-in-out infinite;
   316	}
   317	
   318	.vapor {
   319	  fill: none;
   320	  stroke: rgba(141, 184, 201, 0.9);
   321	  stroke-width: 3;
   322	  stroke-linecap: round;
   323	  stroke-dasharray: 6 10;
   324	  animation: steam 4s linear infinite;
   325	}
   326	
   327	.delayed {
   328	  animation-delay: 0.8s;
   329	}
   330	
   331	.delayed-more {
   332	  animation-delay: 1.4s;
   333	}
   334	
   335	.why-list {
   336	  margin: 0;
   337	  padding-left: 1.1rem;
   338	  display: grid;
   339	  gap: 0.55rem;
   340	}
   341	
   342	.contact {
   343	  text-align: center;
   344	}
   345	
   346	.floating-whatsapp {
   347	  position: fixed;
   348	  right: 1rem;
   349	  bottom: 1rem;
   350	  z-index: 30;
   351	  width: 56px;
   352	  height: 56px;
   353	  border-radius: 999px;
   354	  background: var(--primary);
   355	  color: #fff;
   356	  display: inline-flex;
   357	  align-items: center;
   358	  justify-content: center;
   359	  text-decoration: none;
   360	  box-shadow: 0 12px 24px -14px rgba(15, 123, 112, 0.8);
   361	  font-size: 1.2rem;
   362	}
   363	
   364	.footer {
   365	  border-top: 1px solid var(--line);
   366	  padding: 1rem 0 2rem;
   367	}
   368	
   369	.footer-content {
   370	  display: grid;
   371	  gap: 0.2rem;
   372	  text-align: center;
   373	  color: #627176;
   374	  font-size: 0.94rem;
   375	}
   376	
   377	.reveal {
   378	  opacity: 0;
   379	  transform: translateY(16px);
   380	  transition: opacity 0.7s ease, transform 0.7s ease;
   381	}
   382	
   383	.reveal.show {
   384	  opacity: 1;
   385	  transform: none;
   386	}
   387	
   388	@keyframes drift {
   389	  to {
   390	    transform: translate3d(30px, -20px, 0) scale(1.08);
   391	  }
   392	}
   393	
   394	@keyframes steam {
   395	  0% {
   396	    stroke-dashoffset: 0;
   397	    opacity: 0.5;
   398	  }
   399	  100% {
   400	    stroke-dashoffset: -48;
   401	    opacity: 1;
   402	  }
   403	}
   404	
   405	@keyframes pulse {
   406	  0%,
   407	  100% {
   408	    transform: translateY(0);
   409	  }
   410	  50% {
   411	    transform: translateY(-2px);
   412	  }
   413	}
   414	
   415	@media (max-width: 920px) {
   416	  .menu-toggle {
   417	    display: inline-block;
   418	  }
   419	
   420	  .nav {
1	const WHATSAPP_PHONE = "55SEUNUMEROAQUI";
     2	const DEFAULT_MESSAGE = "Olá! Quero conhecer os produtos boAroma e fazer um pedido.";
     3	
     4	function buildWhatsAppLink(message = DEFAULT_MESSAGE) {
     5	  return `https://wa.me/${WHATSAPP_PHONE}?text=${encodeURIComponent(message)}`;
     6	}
     7	
     8	function bindWhatsAppLinks() {
     9	  const links = document.querySelectorAll(".js-whatsapp-link");
    10	
    11	  links.forEach((link) => {
    12	    const product = link.dataset.product;
    13	    const message = product
    14	      ? `Olá! Quero conhecer ${product} da boAroma e fazer um pedido.`
    15	      : DEFAULT_MESSAGE;
    16	
    17	    link.setAttribute("href", buildWhatsAppLink(message));
    18	    link.setAttribute("target", "_blank");
    19	    link.setAttribute("rel", "noopener noreferrer");
    20	  });
    21	}
    22	
    23	function setupRevealAnimations() {
    24	  const items = document.querySelectorAll(".reveal");
    25	  const observer = new IntersectionObserver(
    26	    (entries) => {
    27	      entries.forEach((entry) => {
    28	        if (entry.isIntersecting) {
    29	          entry.target.classList.add("show");
    30	          observer.unobserve(entry.target);
    31	        }
    32	      });
    33	    },
    34	    { threshold: 0.15 }
    35	  );
    36	
    37	  items.forEach((item) => observer.observe(item));
    38	}
    39	
    40	function setupMobileMenu() {
    41	  const menuToggle = document.querySelector(".menu-toggle");
    42	  const nav = document.querySelector(".nav");
    43	
    44	  if (!menuToggle || !nav) return;
    45	
    46	  menuToggle.addEventListener("click", () => {
    47	    nav.classList.toggle("open");
    48	  });
    49	
    50	  nav.querySelectorAll("a").forEach((link) => {
    51	    link.addEventListener("click", () => nav.classList.remove("open"));
    52	  });
    53	}
    54	
    55	function setCurrentYear() {
    56	  const yearElement = document.getElementById("year");
    57	  if (yearElement) yearElement.textContent = new Date().getFullYear();
    58	}
    59	
    60	bindWhatsAppLinks();
    61	setupRevealAnimations();
    62	setupMobileMenu();
    63	setCurrentYear();
