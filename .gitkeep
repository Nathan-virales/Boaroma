   107	      <section id="processo" class="section section-soft">
   108	        <div class="container process-grid">
   109	          <div class="reveal">
   110	            <p class="tag">Como produzimos</p>
   111	            <h2>Inspiração na destilação por arraste a vapor</h2>
   112	            <ol class="steps">
   113	              <li><strong>Vapor atravessa a matéria-prima</strong> para extrair notas aromáticas.</li>
   114	              <li><strong>Condensação em serpentina</strong> transforma vapor em líquido perfumado.</li>
   115	              <li><strong>Separação e composição</strong> resultam em fragrâncias consistentes e sofisticadas.</li>
   116	            </ol>
   117	          </div>
   118	
   119	          <div class="diagram reveal" aria-label="Diagrama de destilação por arraste a vapor">
   120	            <svg viewBox="0 0 420 280" role="img">
   121	              <defs>
   122	                <linearGradient id="tube" x1="0" y1="0" x2="1" y2="1">
   123	                  <stop offset="0%" stop-color="#d9f4ef" />
   124	                  <stop offset="100%" stop-color="#c6d9ff" />
   125	                </linearGradient>
   126	              </defs>
   127	              <rect x="35" y="165" width="120" height="70" rx="14" class="svg-glass" />
   128	              <path d="M155 198 C205 198, 205 70, 270 70 C330 70, 320 180, 382 180" class="coil" />
   129	              <rect x="337" y="160" width="52" height="75" rx="12" class="svg-glass" />
   130	              <circle cx="88" cy="151" r="5" class="drop" />
   131	              <circle cx="106" cy="138" r="4" class="drop" />
   132	              <circle cx="124" cy="147" r="3" class="drop" />
   133	              <circle cx="356" cy="145" r="4" class="drop delayed" />
   134	              <path d="M58 160 C72 130, 102 125, 126 158" class="vapor" />
   135	              <path d="M78 160 C92 136, 112 134, 132 158" class="vapor delayed" />
   136	              <path d="M98 160 C111 140, 128 142, 139 158" class="vapor delayed-more" />
   137	            </svg>
   138	          </div>
   139	        </div>
   140	      </section>
   141	
   142	      <section id="sobre" class="section">
   143	        <div class="container reveal">
   144	          <p class="tag">Por que boAroma</p>
